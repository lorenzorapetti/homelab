        { "refId": "C", "legendFormat": "{{host}} rx drops", "expr": "max by (host) (rate(node_network_receive_drop_total{device=\"eth0\"}[$__rate_interval]) * on (instance) group_left (host) label_replace(label_join(node_uname_info{nodename=~\"$node\"}, \"host\", \" (\", \"nodename\", \"instance\"), \"host\", \"$1)\", \"host\", \"(.+):[0-9]+\"))" },
        { "refId": "D", "legendFormat": "{{host}} tx drops", "expr": "max by (host) (rate(node_network_transmit_drop_total{device=\"eth0\"}[$__rate_interval]) * on (instance) group_left (host) label_replace(label_join(node_uname_info{nodename=~\"$node\"}, \"host\", \" (\", \"nodename\", \"instance\"), \"host\", \"$1)\", \"host\", \"(.+):[0-9]+\"))" }
