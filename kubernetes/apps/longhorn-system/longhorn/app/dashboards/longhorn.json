{
  "title": "Longhorn",
  "uid": "longhorn",
  "description": "Longhorn volumes (robustness, state, size, I/O), nodes and disks (conditions, space), from longhorn-manager's metrics. Alerts: kubernetes/apps/longhorn-system/longhorn/app/prometheusrule.yaml.",
  "tags": ["kubernetes", "longhorn", "storage"],
  "editable": true,
  "graphTooltip": 1,
  "refresh": "30s",
  "schemaVersion": 39,
  "time": { "from": "now-6h", "to": "now" },
  "timepicker": {},
  "timezone": "browser",
  "annotations": { "list": [] },
  "links": [
    { "type": "link", "title": "Cluster Health", "url": "/d/cluster-health", "icon": "dashboard", "keepTime": true, "targetBlank": false }
  ],
  "templating": {
    "list": [
      {
        "name": "datasource",
        "label": "Data source",
        "type": "datasource",
        "query": "prometheus",
        "current": { "selected": false, "text": "Prometheus", "value": "prometheus" },
        "hide": 0,
        "refresh": 1,
        "options": []
      },
      {
        "name": "namespace",
        "label": "PVC namespace",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "${datasource}" },
        "query": { "query": "label_values(longhorn_volume_capacity_bytes, pvc_namespace)", "refId": "namespace" },
        "definition": "label_values(longhorn_volume_capacity_bytes, pvc_namespace)",
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": { "selected": true, "text": ["All"], "value": ["$__all"] },
        "hide": 0,
        "refresh": 2,
        "sort": 1,
        "options": []
      }
    ]
  },
  "panels": [
    { "id": 100, "type": "row", "title": "Overview", "collapsed": false, "gridPos": { "x": 0, "y": 0, "w": 24, "h": 1 }, "panels": [] },
    {
      "id": 1, "type": "stat", "title": "Volumes",
      "description": "Longhorn volumes in the selected PVC namespaces.",
      "gridPos": { "x": 0, "y": 1, "w": 4, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [ { "refId": "A", "instant": true, "range": false, "expr": "count(max by (volume) (longhorn_volume_capacity_bytes{pvc_namespace=~\"$namespace\"})) or vector(0)" } ],
      "fieldConfig": { "defaults": { "unit": "none", "decimals": 0, "color": { "mode": "fixed", "fixedColor": "blue" } }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "colorMode": "background", "graphMode": "none", "textMode": "value", "justifyMode": "center" }
    },
    {
      "id": 2, "type": "stat", "title": "Degraded",
      "description": "Volumes running with fewer healthy replicas than configured. Normal for a while after a node reboot, until the replica rebuilds; LonghornVolumeDegraded fires after 30 minutes.",
      "gridPos": { "x": 4, "y": 1, "w": 4, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [ { "refId": "A", "instant": true, "range": false, "expr": "count(max by (volume) (longhorn_volume_robustness{pvc_namespace=~\"$namespace\",state=\"degraded\"}) == 1) or vector(0)" } ],
      "fieldConfig": { "defaults": { "unit": "none", "decimals": 0, "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "orange", "value": 1 } ] } }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "colorMode": "background", "graphMode": "none", "textMode": "value", "justifyMode": "center" }
    },
    {
      "id": 3, "type": "stat", "title": "Faulted",
      "description": "Volumes with no healthy replica: their data is unavailable. LonghornVolumeFaulted (critical) fires after 2 minutes.",
      "gridPos": { "x": 8, "y": 1, "w": 4, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [ { "refId": "A", "instant": true, "range": false, "expr": "count(max by (volume) (longhorn_volume_robustness{pvc_namespace=~\"$namespace\",state=\"faulted\"}) == 1) or vector(0)" } ],
      "fieldConfig": { "defaults": { "unit": "none", "decimals": 0, "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "red", "value": 1 } ] } }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "colorMode": "background", "graphMode": "none", "textMode": "value", "justifyMode": "center" }
    },
    {
      "id": 4, "type": "stat", "title": "Nodes not ready or unschedulable",
      "description": "Longhorn nodes whose ready or schedulable condition is False. A cordoned node (Talos upgrade) counts as unschedulable.",
      "gridPos": { "x": 12, "y": 1, "w": 4, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [ { "refId": "A", "instant": true, "range": false, "expr": "count(min by (node) (longhorn_node_status{condition=~\"ready|schedulable\"}) == 0) or vector(0)" } ],
      "fieldConfig": { "defaults": { "unit": "none", "decimals": 0, "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "orange", "value": 1 } ] } }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "colorMode": "background", "graphMode": "none", "textMode": "value", "justifyMode": "center" }
    },
    {
      "id": 5, "type": "stat", "title": "Disks not ready or unschedulable",
      "description": "Longhorn disks whose ready or schedulable condition is False.",
      "gridPos": { "x": 16, "y": 1, "w": 4, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [ { "refId": "A", "instant": true, "range": false, "expr": "count(min by (node, disk) (longhorn_disk_status{condition=~\"ready|schedulable\"}) == 0) or vector(0)" } ],
      "fieldConfig": { "defaults": { "unit": "none", "decimals": 0, "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "orange", "value": 1 } ] } }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "colorMode": "background", "graphMode": "none", "textMode": "value", "justifyMode": "center" }
    },
    {
      "id": 6, "type": "stat", "title": "Fullest disk",
      "description": "The highest disk usage, as a share of what Longhorn may use (capacity minus reservation). LonghornDiskSpaceLow fires above 80%.",
      "gridPos": { "x": 20, "y": 1, "w": 4, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [ { "refId": "A", "instant": true, "range": false, "expr": "max(longhorn_disk_usage_bytes / (longhorn_disk_capacity_bytes - longhorn_disk_reservation_bytes))" } ],
      "fieldConfig": { "defaults": { "unit": "percentunit", "decimals": 0, "min": 0, "max": 1, "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "orange", "value": 0.8 }, { "color": "red", "value": 0.9 } ] } }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "colorMode": "background", "graphMode": "none", "textMode": "value", "justifyMode": "center" }
    },

    { "id": 101, "type": "row", "title": "Volumes", "collapsed": false, "gridPos": { "x": 0, "y": 5, "w": 24, "h": 1 }, "panels": [] },
    {
      "id": 7, "type": "table", "title": "Volumes",
      "description": "Every Longhorn volume with its PVC, robustness (healthy, degraded, faulted, or unknown while detached), state, configured size and the space one replica actually takes on disk. Node is where the volume is attached. Non-healthy rows sort first.",
      "gridPos": { "x": 0, "y": 6, "w": 24, "h": 9 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        { "refId": "A", "instant": true, "range": false, "format": "table", "expr": "max by (pvc_namespace, pvc, volume, node, robustness) (label_replace(longhorn_volume_robustness{pvc_namespace=~\"$namespace\"} == 1, \"robustness\", \"$1\", \"state\", \"(.*)\"))" },
        { "refId": "B", "instant": true, "range": false, "format": "table", "expr": "max by (volume, volume_state) (label_replace(longhorn_volume_state{pvc_namespace=~\"$namespace\"} == 1, \"volume_state\", \"$1\", \"state\", \"(.*)\"))" },
        { "refId": "C", "instant": true, "range": false, "format": "table", "expr": "max by (volume) (longhorn_volume_capacity_bytes{pvc_namespace=~\"$namespace\"})" },
        { "refId": "D", "instant": true, "range": false, "format": "table", "expr": "max by (volume) (longhorn_volume_actual_size_bytes{pvc_namespace=~\"$namespace\"})" }
      ],
      "transformations": [
        { "id": "merge", "options": {} },
        { "id": "organize", "options": {
          "excludeByName": { "Time": true, "Value #A": true, "Value #B": true },
          "indexByName": { "pvc_namespace": 0, "pvc": 1, "robustness": 2, "volume_state": 3, "Value #C": 4, "Value #D": 5, "node": 6, "volume": 7 },
          "renameByName": { "pvc_namespace": "Namespace", "pvc": "PVC", "robustness": "Robustness", "volume_state": "State", "Value #C": "Size", "Value #D": "Actual size", "node": "Node", "volume": "Volume" }
        } }
      ],
      "fieldConfig": {
        "defaults": { "noValue": "No volumes (is longhorn-manager scraped?)", "custom": { "align": "auto", "cellOptions": { "type": "auto" }, "filterable": true } },
        "overrides": [
          { "matcher": { "id": "byName", "options": "Robustness" }, "properties": [ { "id": "custom.width", "value": 110 }, { "id": "custom.cellOptions", "value": { "type": "color-text" } }, { "id": "mappings", "value": [ { "type": "value", "options": { "healthy": { "color": "green", "index": 0 }, "degraded": { "color": "orange", "index": 1 }, "faulted": { "color": "red", "index": 2 }, "unknown": { "color": "text", "index": 3 } } } ] } ] },
          { "matcher": { "id": "byName", "options": "State" }, "properties": [ { "id": "custom.width", "value": 100 } ] },
          { "matcher": { "id": "byName", "options": "Size" }, "properties": [ { "id": "unit", "value": "bytes" }, { "id": "custom.width", "value": 100 } ] },
          { "matcher": { "id": "byName", "options": "Actual size" }, "properties": [ { "id": "unit", "value": "bytes" }, { "id": "custom.width", "value": 110 } ] },
          { "matcher": { "id": "byName", "options": "Node" }, "properties": [ { "id": "custom.width", "value": 90 } ] }
        ]
      },
      "options": { "showHeader": true, "cellHeight": "sm", "footer": { "show": false }, "sortBy": [ { "displayName": "Robustness", "desc": false } ] }
    },
    {
      "id": 8, "type": "timeseries", "title": "Not healthy over time",
      "description": "Degraded and faulted volumes. Short degraded stretches after a node reboot are replica rebuilds.",
      "gridPos": { "x": 0, "y": 15, "w": 8, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [ { "refId": "A", "legendFormat": "{{state}}", "expr": "count by (state) (max by (volume, state) (longhorn_volume_robustness{pvc_namespace=~\"$namespace\",state=~\"degraded|faulted\"}) == 1)" } ],
      "fieldConfig": {
        "defaults": { "unit": "none", "decimals": 0, "min": 0, "noValue": "All healthy", "custom": { "drawStyle": "bars", "fillOpacity": 80, "stacking": { "mode": "normal" }, "showPoints": "never", "lineWidth": 1 } },
        "overrides": [
          { "matcher": { "id": "byName", "options": "degraded" }, "properties": [ { "id": "color", "value": { "mode": "fixed", "fixedColor": "orange" } } ] },
          { "matcher": { "id": "byName", "options": "faulted" }, "properties": [ { "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } } ] }
        ]
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi", "sort": "desc" } }
    },
    {
      "id": 9, "type": "timeseries", "title": "Volume usage",
      "description": "Space one replica takes on disk, as a share of the volume's size. Longhorn doesn't free blocks the filesystem deleted until they are trimmed (the weekly fstrim DaemonSet), so this can stay above what df shows inside the pod.",
      "gridPos": { "x": 8, "y": 15, "w": 16, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [ { "refId": "A", "legendFormat": "{{pvc_namespace}}/{{pvc}}", "expr": "max by (pvc_namespace, pvc) (longhorn_volume_actual_size_bytes{pvc_namespace=~\"$namespace\"}) / max by (pvc_namespace, pvc) (longhorn_volume_capacity_bytes{pvc_namespace=~\"$namespace\"})" } ],
      "fieldConfig": { "defaults": { "unit": "percentunit", "min": 0, "custom": { "fillOpacity": 0, "showPoints": "never", "lineWidth": 1 } }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "right", "calcs": ["lastNotNull"] }, "tooltip": { "mode": "multi", "sort": "desc" } }
    },
    {
      "id": 10, "type": "timeseries", "title": "Write throughput",
      "description": "Bytes written per second, per volume.",
      "gridPos": { "x": 0, "y": 23, "w": 8, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [ { "refId": "A", "legendFormat": "{{pvc_namespace}}/{{pvc}}", "expr": "max by (pvc_namespace, pvc) (longhorn_volume_write_throughput{pvc_namespace=~\"$namespace\"})" } ],
      "fieldConfig": { "defaults": { "unit": "Bps", "min": 0, "custom": { "fillOpacity": 0, "showPoints": "never", "lineWidth": 1 } }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi", "sort": "desc" } }
    },
    {
      "id": 11, "type": "timeseries", "title": "IOPS",
      "description": "Read and write operations per second, per volume.",
      "gridPos": { "x": 8, "y": 23, "w": 8, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        { "refId": "A", "legendFormat": "{{pvc_namespace}}/{{pvc}} write", "expr": "max by (pvc_namespace, pvc) (longhorn_volume_write_iops{pvc_namespace=~\"$namespace\"})" },
        { "refId": "B", "legendFormat": "{{pvc_namespace}}/{{pvc}} read", "expr": "max by (pvc_namespace, pvc) (longhorn_volume_read_iops{pvc_namespace=~\"$namespace\"})" }
      ],
      "fieldConfig": { "defaults": { "unit": "iops", "min": 0, "custom": { "fillOpacity": 0, "showPoints": "never", "lineWidth": 1 } }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi", "sort": "desc" } }
    },
    {
      "id": 12, "type": "timeseries", "title": "Write latency",
      "description": "Average write latency per volume. Every write goes to both replicas, one of them over the network to the other Proxmox host.",
      "gridPos": { "x": 16, "y": 23, "w": 8, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [ { "refId": "A", "legendFormat": "{{pvc_namespace}}/{{pvc}}", "expr": "max by (pvc_namespace, pvc) (longhorn_volume_write_latency{pvc_namespace=~\"$namespace\"})" } ],
      "fieldConfig": { "defaults": { "unit": "ns", "min": 0, "custom": { "fillOpacity": 0, "showPoints": "never", "lineWidth": 1 } }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi", "sort": "desc" } }
    },

    { "id": 102, "type": "row", "title": "Nodes and disks", "collapsed": false, "gridPos": { "x": 0, "y": 31, "w": 24, "h": 1 }, "panels": [] },
    {
      "id": 13, "type": "table", "title": "Conditions",
      "description": "Every Longhorn node and disk condition. False rows sort first; the reason says why.",
      "gridPos": { "x": 0, "y": 32, "w": 8, "h": 9 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        { "refId": "A", "instant": true, "range": false, "format": "table", "expr": "label_replace(max by (node, condition, condition_reason) (longhorn_node_status), \"disk\", \"(node)\", \"node\", \".*\") or max by (node, disk, condition, condition_reason) (longhorn_disk_status)" }
      ],
      "transformations": [ { "id": "organize", "options": { "excludeByName": { "Time": true }, "indexByName": { "node": 0, "disk": 1, "condition": 2, "Value": 3, "condition_reason": 4 }, "renameByName": { "node": "Node", "disk": "Disk", "condition": "Condition", "Value": "Status", "condition_reason": "Reason" } } } ],
      "fieldConfig": {
        "defaults": { "custom": { "align": "auto", "cellOptions": { "type": "auto" }, "filterable": true } },
        "overrides": [
          { "matcher": { "id": "byName", "options": "Status" }, "properties": [ { "id": "custom.width", "value": 70 }, { "id": "custom.cellOptions", "value": { "type": "color-text" } }, { "id": "mappings", "value": [ { "type": "value", "options": { "1": { "text": "True", "color": "green", "index": 0 }, "0": { "text": "False", "color": "red", "index": 1 } } } ] } ] },
          { "matcher": { "id": "byName", "options": "Node" }, "properties": [ { "id": "custom.width", "value": 75 } ] }
        ]
      },
      "options": { "showHeader": true, "cellHeight": "sm", "footer": { "show": false }, "sortBy": [ { "displayName": "Status", "desc": false } ] }
    },
    {
      "id": 14, "type": "timeseries", "title": "Disk usage",
      "description": "Space used on each node's Longhorn disk, as a share of what Longhorn may use (capacity minus reservation). LonghornDiskSpaceLow fires above 80% (dashed line).",
      "gridPos": { "x": 8, "y": 32, "w": 8, "h": 9 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [ { "refId": "A", "legendFormat": "{{node}}", "expr": "longhorn_disk_usage_bytes / (longhorn_disk_capacity_bytes - longhorn_disk_reservation_bytes)" } ],
      "fieldConfig": { "defaults": { "unit": "percentunit", "min": 0, "max": 1, "thresholds": { "mode": "absolute", "steps": [ { "color": "transparent", "value": null }, { "color": "orange", "value": 0.8 } ] }, "custom": { "fillOpacity": 0, "showPoints": "never", "lineWidth": 1, "thresholdsStyle": { "mode": "dashed" } } }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull"] }, "tooltip": { "mode": "multi", "sort": "desc" } }
    },
    {
      "id": 15, "type": "timeseries", "title": "Scheduled storage",
      "description": "The size of the replicas Longhorn has placed on each node, against what it may use there (capacity minus reservation; over-provisioning is 100%). Longhorn stops scheduling new replicas on a node that reaches 100%, even if the replicas aren't full.",
      "gridPos": { "x": 16, "y": 32, "w": 8, "h": 9 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [ { "refId": "A", "legendFormat": "{{node}}", "expr": "longhorn_node_storage_scheduled_bytes / (longhorn_node_storage_capacity_bytes - longhorn_node_storage_reservation_bytes)" } ],
      "fieldConfig": { "defaults": { "unit": "percentunit", "min": 0, "custom": { "fillOpacity": 0, "showPoints": "never", "lineWidth": 1 } }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull"] }, "tooltip": { "mode": "multi", "sort": "desc" } }
    },

    { "id": 103, "type": "row", "title": "Longhorn pods", "collapsed": false, "gridPos": { "x": 0, "y": 41, "w": 24, "h": 1 }, "panels": [] },
    {
      "id": 16, "type": "timeseries", "title": "CPU by node",
      "description": "CPU used by everything in longhorn-system on each node: managers, instance managers (engines and replicas), CSI plugin.",
      "gridPos": { "x": 0, "y": 42, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [ { "refId": "A", "legendFormat": "{{node}}", "expr": "sum by (node) (rate(container_cpu_usage_seconds_total{namespace=\"longhorn-system\",container!=\"\"}[$__rate_interval]) * on (namespace, pod) group_left (node) max by (namespace, pod, node) (kube_pod_info{namespace=\"longhorn-system\"}))" } ],
      "fieldConfig": { "defaults": { "unit": "cores", "min": 0, "custom": { "fillOpacity": 0, "showPoints": "never", "lineWidth": 1 } }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi", "sort": "desc" } }
    },
    {
      "id": 17, "type": "timeseries", "title": "Memory by node",
      "description": "Working set of everything in longhorn-system on each node. Each attached volume adds an engine and a replica process to the instance managers.",
      "gridPos": { "x": 12, "y": 42, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [ { "refId": "A", "legendFormat": "{{node}}", "expr": "sum by (node) (container_memory_working_set_bytes{namespace=\"longhorn-system\",container!=\"\"} * on (namespace, pod) group_left (node) max by (namespace, pod, node) (kube_pod_info{namespace=\"longhorn-system\"}))" } ],
      "fieldConfig": { "defaults": { "unit": "bytes", "min": 0, "custom": { "fillOpacity": 0, "showPoints": "never", "lineWidth": 1 } }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi", "sort": "desc" } }
    }
  ]
}
